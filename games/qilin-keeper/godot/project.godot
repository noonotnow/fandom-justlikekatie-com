; Qilin Keeper: first playable scene. Open this file in Godot 4.4 or newer.
config_version=5

[application]
config/name="Qilin Keeper — Small Paws"
run/main_scene="res://scenes/courtyard.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
boot_splash/show_image=false

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/size/window_width_override=1152
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.31, 0.2, 0.48, 1)

[audio]
driver/enable_input=false
